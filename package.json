{
  "name": "rgt-global-fixture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RGT Global — a deliberately defective, fully catalogued reference website for measuring a localization detector.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "serve:clean": "tsx scripts/serve-local.ts dist-clean 4401",
    "serve:seeded": "tsx scripts/serve-local.ts dist-seeded 4400",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:clean": "tsx scripts/seed.ts --mode=clean",
    "seed:seeded": "tsx scripts/seed.ts --mode=seeded",
    "build:clean": "npm run seed:clean && vite build --outDir dist-clean --emptyOutDir && tsx scripts/prerender.ts --mode=clean --out=dist-clean",
    "build:seeded": "npm run seed:seeded && vite build --outDir dist-seeded --emptyOutDir && tsx scripts/prerender.ts --mode=seeded --out=dist-seeded",
    "build": "npm run build:seeded",
    "gen:vercel": "tsx scripts/gen-vercel.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "verify:manifest": "tsx scripts/verify-manifest.ts",
    "verify:rtl": "tsx scripts/verify-rtl-ready.ts",
    "verify:clean": "npm run seed:clean && tsx scripts/verify-clean.ts dist-clean",
    "verify:seeded": "tsx scripts/verify-seeded.ts dist-seeded",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "verify": "npm run typecheck && npm run lint && npm run verify:rtl && npm run verify:manifest",
    "prepare": "tsx scripts/seed.ts --mode=clean"
  },
  "dependencies": {
    "i18next": "23.16.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.14.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.17.1",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.11",
    "tsx": "4.19.2",
    "typescript": "5.2.2",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.21"
  }
}
