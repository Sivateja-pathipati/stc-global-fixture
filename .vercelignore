# Vercel builds from source on its own machine: it runs installCommand then buildCommand from
# vercel.json. Uploading local build output would be dead weight, and a stale dist-seeded/ in
# the upload is exactly the kind of thing that makes a deployment disagree with the manifest.
node_modules/
dist/
dist-clean/
dist-seeded/
.verify/

# Regenerated by the prepare hook during install. Shipping a locally-seeded copy would let a
# clean-mode build inherit seeded content.
src/constants/generated/

.vercel/
